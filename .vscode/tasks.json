{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Install Siteform dependencies",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"install"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Build Siteform editor",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "Run Siteform local dev server",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"dev",
				"--",
				"--host",
				"127.0.0.1"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Run Siteform on port 5174",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"dev",
				"--",
				"--host",
				"127.0.0.1",
				"--port",
				"5174",
				"--strictPort"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Verify Siteform production build",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "Check local Node SQLite support",
			"type": "shell",
			"command": "node",
			"args": [
				"--version"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Probe Node SQLite availability",
			"type": "shell",
			"command": "node",
			"args": [
				"-e",
				"const { DatabaseSync } = require('node:sqlite'); const db = new DatabaseSync(':memory:'); console.log('node:sqlite DatabaseSync OK'); db.close();"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Install API and upload dependencies",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"install",
				"express",
				"multer",
				"@xmldom/xmldom"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Start local project API",
			"type": "shell",
			"command": "node",
			"args": [
				"server/index.js"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Compile new editor and viewer",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "Build editor and customer viewer",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "Verify local studio build",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			]
		}
	]
}